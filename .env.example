PORT=8080

DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db-name>?sslmode=disable

# Logging. Leave LOG_* empty to use the defaults for APP_ENV:
#   development → LOG_LEVEL=debug, LOG_FORMAT=text, LOG_OUTPUTS=stderr
#   production  → LOG_LEVEL=info,  LOG_FORMAT=json, LOG_OUTPUTS=stdout
APP_ENV=development
LOG_LEVEL=
LOG_FORMAT=
# Comma-separated: stdout, stderr, file:<path>; each may end in @text or @json.
# e.g. LOG_OUTPUTS=stdout@json,file:/var/log/ledger/app.log@json,stderr@text
LOG_OUTPUTS=

# How long an Idempotency-Key's response is kept and replayed (Go duration).
IDEMPOTENCY_TTL=24h